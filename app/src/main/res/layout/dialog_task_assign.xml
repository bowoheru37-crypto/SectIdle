<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    android:background="@drawable/bg_combat_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskDialogName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Assign Task"
            android:textColor="#FFFFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/rbFarming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spirit Farming (Herbs &amp; Crops)"
                android:textColor="#FF4CAF50" />

            <RadioButton
                android:id="@+id/rbAlchemy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alchemy Refinement (Pills)"
                android:textColor="#FF448AFF" />

            <RadioButton
                android:id="@+id/rbCrafting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forge &amp; Crafting (Equipment)"
                android:textColor="#FFFFA726" />

            <RadioButton
                android:id="@+id/rbCultivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meditative Cultivation (Exp)"
                android:textColor="#FFB388FF" />

            <RadioButton
                android:id="@+id/rbMining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spirit Vein Mining (Stones)"
                android:textColor="#FFFFD54F" />

            <RadioButton
                android:id="@+id/rbTraining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Martial Arts Training"
                android:textColor="#FFFF5252" />

            <RadioButton
                android:id="@+id/rbGuard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sect Mountain Patrol"
                android:textColor="#FF90A4AE" />

            <RadioButton
                android:id="@+id/rbResearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scripture Comprehension"
                android:textColor="#FF80D8FF" />

            <RadioButton
                android:id="@+id/rbTrading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marketplace Trading"
                android:textColor="#FFFFD700" />

            <RadioButton
                android:id="@+id/rbExploring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Secret Realm Exploration"
                android:textColor="#FF69F0AE" />
        </RadioGroup>

        <Button
            android:id="@+id/btnConfirmTask"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_jade"
            android:text="Confirm Assignment"
            android:textColor="#FF00E676" />

    </LinearLayout>
</ScrollView>
